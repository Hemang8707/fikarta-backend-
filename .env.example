# Fikarta Backend Microservice Environment Configuration
# Copy this file to .env on the production server

PORT=8000
HOST=0.0.0.0
WORKERS=4

# Path to SQLite database file
DATABASE_PATH=db/fikarta.db

# Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=https://fikarta.money,https://www.fikarta.money,http://localhost:5177

# Environment: production | development
ENV=production

